# large binary artifacts — the authors' released lens, downloadable
# from neuronpedia/jacobian-lens on HF (see lenses/*/config.yaml)
*.pt
__pycache__/
*.pyc
*.egg-info/
.claude/worktrees/
.ruff_cache/
PROTOCOL.md
.venv/
.DS_Store
# local reading copies of third-party texts (links are in commentary/README.md);
# not redistributed in this public repo
paper.md
commentary/*
!commentary/README.md
# generated preview of the post
post/post.html

# the local Markdown copy of the post and its paste instructions (the post itself lives on LessWrong)
post/lesswrong/lesswrong_post.md
post/lesswrong/README.md
